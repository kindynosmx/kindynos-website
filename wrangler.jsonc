{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kindynos-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  // Secrets: `bunx wrangler versions secret put RESEND_API_KEY`
  //          `bunx wrangler versions secret put TURNSTILE_SECRET_KEY`
  "vars": {
    "CONTACT_FROM_EMAIL": "Contacto Kindynos <contact@resend.kindynos.mx>",
    "CONTACT_TO_EMAIL": "contact@kindynos.mx",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAEUxTTX_C0tZok6d",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kindynos-website",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
}
